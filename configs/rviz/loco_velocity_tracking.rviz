Panels:
  - Class: rviz_common/Displays
    Name: Displays
Visualization Manager:
  Global Options:
    Background Color: 48; 48; 48
    Fixed Frame: map
    Frame Rate: 30
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid
      Enabled: true
      Cell Size: 0.5
      Plane: XY
    - Class: rviz_default_plugins/Path
      Name: Actual Path
      Enabled: true
      Topic:
        Value: /loco_velocity_tracking_bridge/path_actual
      Line Width: 0.03
      Color: 255; 80; 80
    - Class: rviz_default_plugins/Path
      Name: Integrated Command Path
      Enabled: true
      Topic:
        Value: /loco_velocity_tracking_bridge/path_command_integrated
      Line Width: 0.03
      Color: 80; 255; 80
    - Class: rviz_default_plugins/MarkerArray
      Name: Velocity Markers
      Enabled: true
      Topic:
        Value: /loco_velocity_tracking_bridge/markers
    - Class: rviz_default_plugins/Odometry
      Name: Actual Odometry
      Enabled: true
      Topic:
        Value: /loco_velocity_tracking_bridge/odom_actual
  Enabled: true
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
  Views:
    Current:
      Class: rviz_default_plugins/TopDownOrtho
      Name: Top Down
      Scale: 80
Window Geometry:
  Width: 1280
  Height: 800
