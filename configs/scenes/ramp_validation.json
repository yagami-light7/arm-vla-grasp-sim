  "mode_defaults": {},
  "usd_asset_bindings": [],
  "required_assets": [
    "tasks/nav_smoke_scan_ramp.json",
    "source/scene/validation_ramp/runtime_asset_manifest.json",
    "source/scene/validation_ramp/scan_ramp.usda",
    "ros2_ws/src/scan_navigation_tools/config/validation_ramp_path.yaml",
    "checkpoints/go2_x5/pct_multifloor/model_26000.pt"
  ]
}
