{
  "schema_version": 1,
  "name": "ramp_validation",
  "aliases": ["scan_ramp", "slope_validation"],
  "description": "用于 SCAN→cmd_vel→pct_multifloor policy 的最小确定性连续斜坡验收场景。",
  "capabilities": [
    "navigation",
    "slope_locomotion_smoke"
  ],
  "task_scene_profile": "ramp_validation",
