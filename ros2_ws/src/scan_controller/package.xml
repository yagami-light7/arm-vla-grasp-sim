<?xml version="1.0"?>
<package format="3">
  <name>scan_controller</name>
  <version>0.1.0</version>
  <description>面向 Go2-X5 的 SCAN B-spline ROS 2 闭环速度控制器。</description>
  <maintainer email="yagami-light7@users.noreply.github.com">pct_scan maintainers</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>bspline_opt</depend>
  <depend>eigen</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>rclcpp</depend>
  <depend>scan_planner_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>std_msgs</depend>

  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>rosgraph_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
